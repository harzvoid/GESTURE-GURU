{
  "manifest_version": 3,
  "name": "SignStream",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Turns speech from the current tab into a 3D sign-language avatar overlay. Runs fully locally: no external APIs.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle SignStream overlay",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html",
        "overlay.js",
        "avatar.js",
        "rig.js",
        "signer.js",
        "gestures.json",
        "lib/three.module.js",
        "lib/three.core.js",
        "lib/FBXLoader.js",
        "model/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "GestureGuru",
  "version": "1.0",
  "description": "GestureGuru converts video speech to sign language in real-time, displaying a 3D avatar that syncs with any video. It makes content accessible for the deaf and hard-of-hearing community.",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "tabCapture",
    "system.display",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_title": "GestureGuru"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "build/ybot.glb",
        "src/Animations/*.glb",
        "*.png",
        "*.js",
        "*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
